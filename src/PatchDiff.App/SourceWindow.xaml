<Window x:Class="PatchDiff.SourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="640"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e22"
        TextElement.Foreground="#e6e6e6">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#26262b" BorderBrush="#33333a" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="TypeNameText" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="AssemblyText" FontSize="11" Foreground="#9a9aa4" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <TextBox x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                 Background="#1b1b1f" BorderThickness="0" Padding="10,8"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>
    </DockPanel>
</Window>
