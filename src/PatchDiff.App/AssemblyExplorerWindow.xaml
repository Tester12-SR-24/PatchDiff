<Window x:Class="PatchDiff.AssemblyExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PatchDiff"
        Width="1150" Height="700"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e22"
        TextElement.Foreground="#e6e6e6">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#26262b" BorderBrush="#33333a" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="AssemblyNameText" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="AssemblyMetaText" FontSize="11" Foreground="#9a9aa4" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="TypeTree" Grid.Column="0" Background="#1b1b1f" BorderThickness="0"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectedItemChanged="OnTreeSelectionChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="False"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <!-- assembly root -->
                    <HierarchicalDataTemplate DataType="{x:Type local:ExplorerNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Foreground="#8a8a95" Margin="0,0,6,0" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding Header}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#e6e6e6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Type">
                                                <Setter Property="Foreground" Value="#7fb2e8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Namespace">
                                                <Setter Property="Foreground" Value="#b9c3d6"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Member">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontSize" Value="11.5"/>
                                                <Setter Property="Foreground" Value="#cdd3de"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="4"/>

            <DockPanel Grid.Column="2" Margin="0,10,10,10">
                <TextBlock DockPanel.Dock="Top" x:Name="SourceHeader" FontWeight="SemiBold" Margin="4,0,0,6"/>
                <TextBox x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="12" Background="#1b1b1f" BorderThickness="0"
                         Padding="10,8" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         CaretBrush="#4cc2ff" SelectionBrush="#3a5a8a"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
