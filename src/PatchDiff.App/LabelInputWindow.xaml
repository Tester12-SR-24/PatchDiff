<Window x:Class="PatchDiff.LabelInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e22"
        TextElement.Foreground="#e6e6e6">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelText" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="ValueBox" VerticalContentAlignment="Center" Padding="6,5"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="Save" Click="OnSave" Padding="12,5" Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
