<Window x:Class="PatchDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PatchDiff"
        xmlns:ctl="clr-namespace:PatchDiff"
        Title="PatchDiff — watching your assemblies"
        Icon="icon.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop"
        Background="#1e1e22"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.Foreground="#e6e6e6">

    <Window.Resources>
        <local:KindToBrushConverter x:Key="DiffBrush"/>
        <local:CollapsedWhenHasItemsConverter x:Key="CollapsedWhenHasItems"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="PillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3a3a42"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PillKind}" Value="updated"><Setter Property="Background" Value="#8a6d1f"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="ok"><Setter Property="Background" Value="#274a33"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="baseline"><Setter Property="Background" Value="#2b6b3a"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="busy"><Setter Property="Background" Value="#2b4b73"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="error"><Setter Property="Background" Value="#7a2e33"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#d5d5dc"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PillKind}" Value="updated"><Setter Property="Foreground" Value="#ffe9a8"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="ok"><Setter Property="Foreground" Value="#9fe0b3"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="baseline"><Setter Property="Foreground" Value="#b8f5c9"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="busy"><Setter Property="Foreground" Value="#a8d3ff"/></DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="error"><Setter Property="Foreground" Value="#ffc4c8"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#8a8a95"/>
            <Setter Property="Margin" Value="2,10,0,6"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Add _DLL to watch…" Click="OnAddDll"/>
                <MenuItem Header="Add all DLLs in _folder…" Click="OnAddFolder"/>
                <MenuItem Header="_Remove selected watch" Click="OnRemoveWatch"/>
                <Separator/>
                <MenuItem Header="Compare _two DLLs…" Click="OnCompareTwo"/>
                <MenuItem Header="_Reload all (F5)" Click="OnReloadAll"/>
                <Separator/>
                <MenuItem Header="Open _reports folder" Click="OnOpenReports"/>
                <MenuItem x:Name="AutoStartItem" Header="Start with Windows" IsCheckable="True" Click="OnToggleAutoStart"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _updates…" Click="OnCheckForUpdates"/>
                <Separator/>
                <MenuItem Header="_Settings…" Click="OnSettings"/>
                <MenuItem Header="_About PatchDiff" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- main: rail | tabs | intel -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- left rail -->
                <DockPanel Grid.Column="0" Margin="10,8,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" VerticalContentAlignment="Center"
                            AutomationProperties.Name="Search .cs files"/>
                        <TextBlock Text="Search .cs files…" Foreground="#6f6f79" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconAdd}" Content="Add DLL" Click="OnAddDll" Style="{StaticResource AccentButton}" Padding="7,3" FontSize="11" Margin="0,0,6,4" ToolTip="Add a DLL to watch"/>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconFolder}" Content="Folder…" Click="OnAddFolder" Padding="7,3" FontSize="11" Margin="0,0,6,4" ToolTip="Add every DLL in a folder"/>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconSettings}" Content="Settings" Click="OnSettings" Padding="7,3" FontSize="11" Margin="0,0,6,4" ToolTip="Settings"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="WATCHED ASSEMBLIES" Style="{StaticResource SectionHeader}"/>
                    <ListBox x:Name="WatchedList" DockPanel.Dock="Top" MaxHeight="200"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnWatchDoubleClicked"
                             SelectionChanged="OnWatchSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2" Orientation="Horizontal">
                                    <Image Source="icon.ico" Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource PillBorder}">
                                        <TextBlock Text="{Binding PillText}" Style="{StaticResource PillText}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock DockPanel.Dock="Top" Text="SELECTED ASSEMBLY" Style="{StaticResource SectionHeader}"/>
                    <UniformGrid x:Name="AssemblyActions" DockPanel.Dock="Top" Columns="2" Margin="0,0,4,6" IsEnabled="False">
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconBrowse}" Content="Browse" Click="OnBrowse" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="Explore types and source">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconDiff}" Content="Diff" Click="OnOpenDiff" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="Latest diff">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconHistory}" Content="History" Click="OnHistory" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="Revisions + matrix">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconSources}" Content="Sources" Click="OnExportSources" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="Export .cs files">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconReport}" Content="Report" Click="OnOpenReport" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="HTML report">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconRecheck}" Content="Re-check" Click="OnRecheck" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="Re-check now">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconRemove}" Content="Remove" Click="OnRemoveWatch" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="Stop watching">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button ctl:IconGlyph.Geometry="{StaticResource IconRemoveAll}" Content="× All" Click="OnRemoveAll" Margin="0,0,4,4" Padding="4,6" FontSize="10.5" ToolTip="Stop watching all">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="50">
                                        <StackPanel VerticalAlignment="Center">
                                            <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ctl:IconGlyph.Geometry)}"
                                                  Stroke="{TemplateBinding Foreground}" Fill="{x:Null}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#1c1c20"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2b2b31"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </UniformGrid>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,10,8,4">
                        <TextBlock Text="TIMELINE" Style="{StaticResource SectionHeader}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearTimeline" Padding="7,2" FontSize="10" ToolTip="Clear the timeline"/>
                    </DockPanel>
                    <ListBox x:Name="TimelineList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- timeline dot -->
                                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Top"
                                             Margin="1,5,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#6f6f79"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="patched">
                                                        <Setter Property="Fill" Value="#e0a83a"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="baseline">
                                                        <Setter Property="Fill" Value="#4caf6a"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="info">
                                                        <Setter Property="Fill" Value="#4a76c8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="9.5"
                                                       Foreground="#6f6f79" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8a8a95"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="patched">
                                                                <Setter Property="Foreground" Value="#e0a83a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="baseline">
                                                                <Setter Property="Foreground" Value="#6ccb87"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="info">
                                                                <Setter Property="Foreground" Value="#7fa8e8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="10.5" Foreground="#c3c8d2"
                                                   TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Message}" Margin="0,1,0,2"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <Border Background="#2b2b31" BorderBrush="#454956" BorderThickness="1" CornerRadius="7"
                                Padding="5" MinWidth="380" SnapsToDevicePixels="True">
                            <ListBox x:Name="SearchResults" MinWidth="380" MaxHeight="380"
                                     PreviewKeyDown="OnSearchResultKeyDown"
                                     MouseDoubleClick="OnSearchResultActivated">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding CsFile}" FontWeight="SemiBold" FontFamily="Consolas" FontSize="12"/>
                                            <TextBlock Text="{Binding AssemblyName}" Foreground="#6f6f79" FontSize="10.5"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </DockPanel>

                <GridSplitter Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="4"/>

                <!-- center: tabs + log -->
                <DockPanel Grid.Column="2" Margin="8,8,8,0">
                    <ListBox DockPanel.Dock="Bottom" x:Name="LogList" Height="90" BorderThickness="0" Background="#18181c"
                             FontFamily="Consolas" FontSize="11" Foreground="#9ee49e"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    <TabControl x:Name="WorkTabs" Background="#1b1b1f" BorderThickness="1"
                                BorderBrush="#33333a" Padding="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}" Margin="2,0,8,0"/>
                                    <Button Content="" FontSize="9" Padding="3,0" Background="Transparent" ctl:IconGlyph.Geometry="{StaticResource IconClose}"
                                            Foreground="#9a9aa9" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding CloseCommand}"
                                            Visibility="{Binding IsClosable, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding Content}"/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </DockPanel>

                <!-- intel rail -->
                
            </Grid>

            <!-- footer -->
            <Border Grid.Row="1" Background="#1b1b1f" BorderBrush="#33333a" BorderThickness="0,1,0,0" Padding="12,5">
                <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="#9a9aa4"/>
            </Border>
        </Grid>
    </DockPanel>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.ReloadAllCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.ReloadAllCommand}" Executed="OnReloadAllExecuted"/>
    </Window.CommandBindings>
</Window>
