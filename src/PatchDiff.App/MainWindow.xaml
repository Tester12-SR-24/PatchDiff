<Window x:Class="PatchDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PatchDiff"
        Title="PatchDiff — Patch Feed"
        Icon="icon.ico"
        AllowDrop="True"
        Drop="OnDrop"
        Width="1200" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e22"
        TextElement.Foreground="#e6e6e6">

    <Window.Resources>
        <local:KindToBrushConverter x:Key="DiffBrush"/>
        <local:CollapsedWhenHasItemsConverter x:Key="CollapsedWhenHasItems"/>

        <!-- Status pill -->
        <Style x:Key="PillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PillKind}" Value="updated">
                    <Setter Property="Background" Value="#8a6d1f"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="ok">
                    <Setter Property="Background" Value="#274a33"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="baseline">
                    <Setter Property="Background" Value="#2b6b3a"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="busy">
                    <Setter Property="Background" Value="#2b4b73"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="error">
                    <Setter Property="Background" Value="#7a2e33"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#d5d5dc"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PillKind}" Value="updated">
                    <Setter Property="Foreground" Value="#ffe9a8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="ok">
                    <Setter Property="Foreground" Value="#9fe0b3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="baseline">
                    <Setter Property="Foreground" Value="#b8f5c9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="busy">
                    <Setter Property="Foreground" Value="#a8d3ff"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PillKind}" Value="error">
                    <Setter Property="Foreground" Value="#ffc4c8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Timeline badge -->
        <Style x:Key="EvtBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3a3a42"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="patched">
                    <Setter Property="Background" Value="#7a5a12"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="baseline">
                    <Setter Property="Background" Value="#2b6b3a"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EvtBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#d5d5dc"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="patched">
                    <Setter Property="Foreground" Value="#ffdf8e"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="baseline">
                    <Setter Property="Foreground" Value="#b8f5c9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8a8a95"/>
            <Setter Property="Margin" Value="2,2,0,8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Add _DLL to watch…" Click="OnAddDll"/>
                <MenuItem Header="Add all DLLs in _folder…" Click="OnAddFolder"/>
                <MenuItem Header="_Remove selected watch" Click="OnRemoveWatch"/>
                <Separator/>
                <MenuItem Header="Compare _two DLLs…" Click="OnCompareTwo"/>
                <Separator/>
                <MenuItem Header="Open _reports folder" Click="OnOpenReports"/>
                <MenuItem x:Name="AutoStartItem" Header="Start with Windows" IsCheckable="True"
                          Click="OnToggleAutoStart" ToolTip="Launch PatchDiff automatically at Windows logon so DLL watching resumes after a reboot."/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _updates…" Click="OnCheckForUpdates"/>
                <Separator/>
                <MenuItem Header="_About PatchDiff" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#232327" BorderBrush="#33333a" BorderThickness="0,0,0,1">
            <Grid>
            <StackPanel Orientation="Horizontal" Margin="10,7">
                <Button Content="➕ Add DLL" Click="OnAddDll"/>
                <Button Content="📂 Watch folder…" Click="OnAddFolder"/>
                <Button Content="⇄ Compare two…" Click="OnCompareTwo"/>
                <Button Content="↻ Re-check" Click="OnRecheck"/>
                <Button Content="🔄 All (F5)" Click="OnReloadAll"/>
                <Button Content="🗑 Remove" Click="OnRemoveWatch"/>
                <Button Content="📁 Reports" Click="OnOpenReports"/>
                <Grid Width="240" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" VerticalContentAlignment="Center"/>
                    <TextBlock Text="🔍 Search types…" Foreground="#6f6f79" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border Background="#2b2b31" BorderBrush="#454956" BorderThickness="1" CornerRadius="7"
                        Padding="5" MinWidth="420" SnapsToDevicePixels="True">
                    <ListBox x:Name="SearchResults" MinWidth="420" MaxHeight="380"
                             PreviewKeyDown="OnSearchResultKeyDown"
                             MouseDoubleClick="OnSearchResultActivated">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding AssemblyName}" Foreground="#6f6f79" FontSize="10.5"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
            </Grid>
        </Border>

        <!-- Watched DLL cards -->
        <Border DockPanel.Dock="Top" BorderBrush="#33333a" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,10,14,0">
                <TextBlock DockPanel.Dock="Top" Text="WATCHED ASSEMBLIES" Style="{StaticResource SectionHeader}"/>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                    <Grid>
                        <ListBox x:Name="CardsList" BorderThickness="0" Background="Transparent"
                                 SelectionMode="Extended"
                                 MouseDoubleClick="OnCardDoubleClick">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        BorderBrush="Transparent" BorderThickness="1.5"
                                                        CornerRadius="10" Padding="1.5">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="#4a76c8"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="#3a3d47"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="330" Height="164" Background="#26262b" BorderBrush="#38383f"
                                        BorderThickness="1" CornerRadius="9" Padding="13,11" Margin="0,0,12,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Style="{StaticResource PillBorder}">
                                                <TextBlock Style="{StaticResource PillText}" Text="{Binding PillText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Meta1}" FontSize="11" Foreground="#9a9aa4" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding ChangeSummary}" FontSize="11" Foreground="#c9a34e"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="#6f6f79" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#6f6f79"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                   ToolTip="{Binding Path}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Open diff" Click="OnOpenDiff" Padding="9,3"/>
                                            <Button Content="HTML report" Click="OnOpenReport" Padding="9,3"/>
                                            <Button Content="▸ Browse" Click="OnBrowse" Padding="8,3"/>
                                            <Button Content="↓ Sources" Click="OnExportSources" Padding="8,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ListBox>
                        <TextBlock Text="No DLLs watched yet — use ➕ DLL… or 📂 Folder… above"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#6f6f79" FontSize="13"
                                   Margin="0,30,0,30">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=CardsList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Footer status -->
        <Border DockPanel.Dock="Bottom" Background="#1b1b1f" BorderBrush="#33333a" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="FooterText" FontSize="11.5" Foreground="#9a9aa4"/>
        </Border>

        <!-- Activity log -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#33333a" BorderThickness="0,1,0,0" Background="#18181c">
            <ListBox x:Name="LogList" Height="96" BorderThickness="0" Background="Transparent"
                     FontFamily="Consolas" FontSize="11" Foreground="#9ee49e"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Timeline -->
        <DockPanel Margin="14,10,14,4">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,2">
                <TextBlock Text="DETECTED UPDATES" Style="{StaticResource SectionHeader}" Margin="2,0,0,0"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="Clear" Click="OnClearTimeline" Padding="10,2" FontSize="11"/>
            </DockPanel>
            <Grid>
                <TextBlock Text="No updates detected yet. PatchDiff is standing by &#8212; drop a game update in and it will appear here."
                           Foreground="#6f6f79" FontSize="12" Margin="2,6,0,0"
                           Visibility="{Binding HasItems, ElementName=TimelineList, Converter={StaticResource CollapsedWhenHasItems}}"/>
                <ListBox x:Name="TimelineList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding When}" FontSize="11" Foreground="#8a8a95" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource EvtBadge}" Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource EvtBadgeText}" Text="{Binding Badge}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
