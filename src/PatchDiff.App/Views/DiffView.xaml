<UserControl x:Class="PatchDiff.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PatchDiff"
             Background="#1e1e22"
             TextElement.Foreground="#e6e6e6">
    <UserControl.Resources>
        <local:KindToBrushConverter x:Key="DiffBrush"/>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#26262b" BorderBrush="#33333a" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock FontSize="11.5"><Run x:Name="AddedRun" Foreground="#7be495" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock FontSize="11.5" Margin="10,0,0,0"><Run x:Name="RemovedRun" Foreground="#ff8fa0" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock FontSize="11.5" Margin="10,0,0,0"><Run x:Name="ModifiedRun" Foreground="#ffd166" FontWeight="SemiBold"/></TextBlock>
                    <TextBlock FontSize="11" Foreground="#6f6f79" Margin="14,0,0,0"><Run x:Name="ShaRun"/></TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,10,0,0">
            <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="10,0,10,6" TextChanged="OnFilterChanged"
                     VerticalContentAlignment="Center"/>
            <TextBlock DockPanel.Dock="Top" Text="CHANGED TYPES" FontSize="11" Foreground="#8a8a95" Margin="12,0,0,6"/>
            <ListBox x:Name="TypesList" Background="#1b1b1f" BorderThickness="0"
                     SelectionChanged="OnTypeSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <Border Background="{Binding Change, Converter={StaticResource DiffBrush}}"
                                    CornerRadius="8" Padding="7,1" Margin="0,0,7,0">
                                <TextBlock Text="{Binding DisplayChange}" FontSize="10"/>
                            </Border>
                            <TextBlock Text="{Binding FullName}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="4"/>

        <DockPanel Grid.Column="2" Margin="0,10,4,10">
            <TextBlock DockPanel.Dock="Top" x:Name="TypeHeader" FontWeight="SemiBold" Margin="4,0,0,6"/>
            <ListView x:Name="DiffList" Background="#1b1b1f" BorderThickness="0"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      FontFamily="Consolas" FontSize="12">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="Previous version" Width="480">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OldText}" Padding="5,0" Margin="-5,0" MinHeight="17"
                                               Background="{Binding OldKind, Converter={StaticResource DiffBrush}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="New version" Width="480">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NewText}" Padding="5,0" Margin="-5,0" MinHeight="17"
                                               Background="{Binding NewKind, Converter={StaticResource DiffBrush}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <DockPanel Grid.Column="4" Margin="0,10,10,10">
            <TextBlock DockPanel.Dock="Top" Text="🧠 THIS PATCH" FontSize="11" Foreground="#8a8a95" Margin="2,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="IntelPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
    </DockPanel>
</UserControl>
