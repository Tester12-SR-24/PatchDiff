<UserControl x:Class="PatchDiff.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PatchDiff"
             xmlns:views="clr-namespace:PatchDiff.Views"
             Background="#1e1e22"
             TextElement.Foreground="#e6e6e6">
    <UserControl.Resources>
        <local:KindToBrushConverter x:Key="DiffBrush"/>
        <local:KindToEdgeBrushConverter x:Key="DiffEdge"/>
        <local:KindToTextBrushConverter x:Key="DiffText"/>
        <local:CollapsedWhenEmptyConverter x:Key="CollapsedWhenEmpty"/>
        <Style x:Key="DiffRowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#26262b"/>
            <Setter Property="Foreground" Value="#cfcfda"/>
            <Setter Property="BorderBrush" Value="#33333a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303038"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#26262b" BorderBrush="#33333a" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock FontSize="11.5"><Run x:Name="AddedRun" Foreground="#7be495" FontWeight="SemiBold"/></TextBlock>
                        <TextBlock FontSize="11.5" Margin="10,0,0,0"><Run x:Name="RemovedRun" Foreground="#ff8fa0" FontWeight="SemiBold"/></TextBlock>
                        <TextBlock FontSize="11.5" Margin="10,0,0,0"><Run x:Name="ModifiedRun" Foreground="#ffd166" FontWeight="SemiBold"/></TextBlock>
                        <TextBlock FontSize="11" Foreground="#6f6f79" Margin="14,0,0,0"><Run x:Name="ShaRun"/></TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Expand all" Click="OnExpandAll"/>
                    <Button Style="{StaticResource GhostButton}" Content="Collapse all" Click="OnCollapseAll" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel>
            <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="10,10,10,6" TextChanged="OnFilterChanged"
                     Background="#26262b" Foreground="#e6e6e6" BorderBrush="#33333a" CaretBrush="#e6e6e6"
                     VerticalContentAlignment="Center"/>
            <ListBox x:Name="SectionList" Background="#1b1b1f" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource DiffRowContainer}"
                     FontFamily="Consolas" FontSize="12"
                     AlternationCount="0">
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type views:SectionVm}">
                        <Border Background="#202025" BorderBrush="#33333a" BorderThickness="0,0,0,1" Padding="12,7,12,7"
                                PreviewMouseLeftButtonDown="OnSectionClick" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Chevron" Text="▶" FontSize="9" Foreground="#9a9aa9"
                                           VerticalAlignment="Center" Margin="0,1,9,0"/>
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="12.5"
                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border Background="#22371F" CornerRadius="9" Padding="7,1" Margin="0,0,5,0"
                                            Visibility="{Binding AddBadge, Converter={StaticResource CollapsedWhenEmpty}}">
                                        <TextBlock Text="{Binding AddBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="#7be495"
                                                   FontFamily="Segoe UI"/>
                                    </Border>
                                    <Border Background="#3A2126" CornerRadius="9" Padding="7,1" Margin="0,0,5,0"
                                            Visibility="{Binding RemBadge, Converter={StaticResource CollapsedWhenEmpty}}">
                                        <TextBlock Text="{Binding RemBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="#ff8fa0"
                                                   FontFamily="Segoe UI"/>
                                    </Border>
                                    <Border Background="#39301A" CornerRadius="9" Padding="7,1" Margin="0,0,5,0"
                                            Visibility="{Binding ModBadge, Converter={StaticResource CollapsedWhenEmpty}}">
                                        <TextBlock Text="{Binding ModBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="#ffd166"
                                                   FontFamily="Segoe UI"/>
                                    </Border>
                                    <Border Background="#26262b" BorderBrush="#33333a" BorderThickness="1" CornerRadius="9" Padding="7,1">
                                        <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="#9a9aa9" FontFamily="Segoe UI"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="▼"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type views:DiffRowVm}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border MinHeight="19" BorderThickness="3,0,0,0"
                                    Background="{Binding OldKind, Converter={StaticResource DiffBrush}}"
                                    BorderBrush="{Binding OldKind, Converter={StaticResource DiffEdge}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OldLine}" FontSize="10.5" Foreground="#55555f"
                                               TextAlignment="Right" Padding="0,1,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OldText}" Padding="0,1,8,1"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding OldKind, Converter={StaticResource DiffText}}"/>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" MinHeight="19" BorderThickness="3,0,0,0"
                                    Background="{Binding NewKind, Converter={StaticResource DiffBrush}}"
                                    BorderBrush="{Binding NewKind, Converter={StaticResource DiffEdge}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NewLine}" FontSize="10.5" Foreground="#55555f"
                                               TextAlignment="Right" Padding="0,1,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NewText}" Padding="0,1,8,1"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding NewKind, Converter={StaticResource DiffText}}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </DockPanel>
    </DockPanel>
</UserControl>
