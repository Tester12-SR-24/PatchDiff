<UserControl x:Class="PatchDiff.Views.MatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e22"
             TextElement.Foreground="#e6e6e6">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Revision matrix" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,2"/>
        <TextBlock x:Name="SubtitleText" DockPanel.Dock="Top" Text="Pick any two revisions: click a cell to compute that pair's diff (computed lazily on click). Click again to open it."
                   FontSize="11" Foreground="#9a9aa9" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MatrixGrid"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
