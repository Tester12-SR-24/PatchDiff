<UserControl x:Class="PatchDiff.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e22"
             TextElement.Foreground="#e6e6e6">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#26262b" BorderBrush="#33333a" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="MetaText" FontSize="11" Foreground="#9a9aa9" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#1b1b1f" BorderBrush="#33333a" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock FontSize="11" Foreground="#6f6f79"
                       Text="'diff vs previous' compares a revision with the one before it; 'diff vs current' compares with the newest archived version."/>
        </Border>

        <ListBox x:Name="RevList" Background="#1b1b1f" BorderThickness="0" Margin="10"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ShaShort}" FontFamily="Consolas" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding WhenLocal}" FontSize="10.5" Foreground="#9a9aa9"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionLabel}"/>
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10.5" Foreground="#6f6f79"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Diff vs previous" Click="OnDiffPrev" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="Diff vs current" Click="OnDiffCurrent" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="Restore…" Click="OnRestore" Padding="8,3" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="▦ Matrix" Click="OnMatrix" Padding="8,3" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
