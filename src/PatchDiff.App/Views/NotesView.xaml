<UserControl x:Class="PatchDiff.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e22"
             TextElement.Foreground="#e6e6e6">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="📌 Pinned types &amp; notes" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,10"/>
        <TextBlock DockPanel.Dock="Top" Text="Pins track a type across patches. Notes persist per type and surface here whenever the pinned type changes in a new patch."
                   FontSize="11" Foreground="#9a9aa9" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ListBox x:Name="PinList" Background="#1b1b1f" BorderThickness="0" Margin="0,0,0,10"
                 HorizontalContentAlignment="Stretch" SelectionChanged="OnPinSelected">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2" Orientation="Horizontal">
                        <Border Background="{Binding ChangedBrush}" CornerRadius="8" Padding="7,1" Margin="0,0,8,0">
                            <TextBlock Text="{Binding StatusText}" FontSize="10"/>
                        </Border>
                        <TextBlock Text="{Binding TypeName}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="NOTE FOR SELECTED TYPE" FontSize="10.5" Foreground="#8a8a95" Margin="0,0,0,4"/>
            <TextBox x:Name="NoteBox" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="💾 Save note" Click="OnSaveNote" Padding="9,4"/>
                <Button Content="✖ Unpin" Click="OnUnpin" Padding="9,4"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
