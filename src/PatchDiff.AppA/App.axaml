    </DrawingImage>
    <DrawingImage x:Key="IconReport">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M5,3.5 h9 l5,5 v12 H5 Z M14,3.5 v5 h5">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M8,16 v-2.5 M12,16 v-5 M16,16 v-3.5">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.8" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M8,18.5 h8">
            <GeometryDrawing.Pen><Pen Brush="#a78bfa" Thickness="1.6" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    </ResourceDictionary>
  </Application.Resources>
</Application>
