            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.7" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#a78bfa" Geometry="F1 M11,12 m-.8,0 a.8,.8 0 1 0 1.6,0 a.8,.8 0 1 0 -1.6,0" />
          <GeometryDrawing Brush="#202a3a" Geometry="F1 M19,18 m-3.8,0 a3.8,3.8 0 1 0 7.6,0 a3.8,3.8 0 1 0 -7.6,0">
            <GeometryDrawing.Pen><Pen Brush="#a78bfa" Thickness="1.5" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M19,16 v4 m-2,-2 h4">
