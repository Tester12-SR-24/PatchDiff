<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PatchDiff.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="Background" Value="#2a2a30" />
      <Setter Property="Foreground" Value="#e6e6ea" />
      <Setter Property="BorderBrush" Value="#3a3a42" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#34343c" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#26262c" />
      <Setter Property="Foreground" Value="#e6e6ea" />
      <Setter Property="BorderBrush" Value="#3a3a42" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#1e1e22" />
      <Setter Property="Foreground" Value="#e6e6ea" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2a2a30" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#31455f" />
    </Style>
  </Application.Styles>
</Application>
