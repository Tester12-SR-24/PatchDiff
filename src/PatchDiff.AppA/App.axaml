<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PatchDiff.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, Ubuntu, Cantarell, DejaVu Sans, Noto Sans, Arial" />
      <Setter Property="Background" Value="#0e1219" />
      <Setter Property="Foreground" Value="#e8edf5" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#202838" />
      <Setter Property="Foreground" Value="#dce4ef" />
      <Setter Property="BorderBrush" Value="#354154" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2b3545" />
      <Setter Property="BorderBrush" Value="#526277" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#18212e" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#56d3c7" />
      <Setter Property="Foreground" Value="#101820" />
      <Setter Property="BorderBrush" Value="#56d3c7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#75e1d6" />
    </Style>
    <!-- Primary buttons carry three icons: dark for the bright teal (enabled), the DEFAULT
         light icon for the dimmed (disabled) state, and white for hover — Fluent's
         pointerover style turns the label white, so the icon follows it. -->
    <Style Selector="Image.lightIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Image.whiteIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.primary:disabled Image.darkIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.primary:disabled Image.lightIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.primary:pointerover Image.darkIcon">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.primary:pointerover Image.whiteIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#202838" />
      <Setter Property="Foreground" Value="#dce4ef" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#aab4c4" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1c2733" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#20353b" />
      <Setter Property="Foreground" Value="#68ded2" />
    </Style>
    <!-- Highlighted while a newer release is known to exist. -->
    <Style Selector="Button.nav.update">
      <Setter Property="Background" Value="#2b2416" />
      <Setter Property="Foreground" Value="#f0c674" />
    </Style>
    <Style Selector="Button.nav.update:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3a301c" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="#1b2330" />
      <Setter Property="BorderBrush" Value="#303a4b" />
    </Style>
    <Style Selector="Button.toolbar.danger">
      <Setter Property="Foreground" Value="#ff9ba2" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#8d9bb0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#171e29" />
      <Setter Property="Foreground" Value="#e6ebf3" />
      <Setter Property="BorderBrush" Value="#30394a" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#e6ebf3" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1a222e" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#202b38" />
    </Style>
    <Style Selector="Border.watch-row">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.DiffSection">
      <Setter Property="Background" Value="#20262f" />
      <Setter Property="BorderBrush" Value="#2c3644" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.DiffSection:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2a3340" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#79869b" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Diff Workbench icon set (24px line style, slate strokes with cyan/violet accents). -->
      </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
<DrawingImage x:Key="IconDashboard">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M3,3 h8 v8 h-8 Z M13,3 h8 v5 h-8 Z M13,10 h8 v11 h-8 Z M3,13 h8 v8 h-8 Z">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5.5,7 h3 M15.5,5.5 h3 M15.5,13 h3 M5.5,17 h3">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.7" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M17.2,17 h1.6">
            <GeometryDrawing.Pen><Pen Brush="#a78bfa" Thickness="1.7" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconRefresh">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M19.5,12 A7.5,7.5 0 1 1 17.3,6.7">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M19.8,3.8 L19.8,7.7 L15.9,7.7">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.8" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing>
            <GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="1" RadiusY="1" /></GeometryDrawing.Geometry>
            <GeometryDrawing.Brush><SolidColorBrush Color="#a78bfa" /></GeometryDrawing.Brush>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconCompare">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M2.5,4 h8 v16 h-8 Z M13.5,4 h8 v16 h-8 Z">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5,8 h3 M5,11 h2 M16,11 h3">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.5" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5,15 h3 M16,15 h3 M16,8 h3">
            <GeometryDrawing.Pen><Pen Brush="#a78bfa" Thickness="1.5" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M9,11 h6 m-2,-2 2,2 -2,2">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.5" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconBrowse">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M4,4.5 h10 l3,3 V14 M14,4.5 v3 h3 M6.5,10 h5 M6.5,13 h3 M6.5,10 h5">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M6.5,10 h5">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.7" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M15.5,15 m-3.5,0 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0">
            <GeometryDrawing.Pen><Pen Brush="#a78bfa" Thickness="1.7" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M18,17.5 l3,3">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.9" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconHistory">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M4,8 a8.5,8.5 0 1 1 -1,5">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.7" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M3,4.5 V9 h4.5">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.8" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M12.5,7.5 v5 l3.5,2">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.8" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#a78bfa" Geometry="F1 M12.5,12.5 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconSettings">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M9.7,3.5 h4.6 l.6,2.1 a7,7 0 0 1 1.6,.9 l2.1,-.7 2.3,4 -1.5,1.6 a7,7 0 0 1 0,1.9 l1.5,1.6 -2.3,4 -2.1,-.7 a7,7 0 0 1 -1.6,.9 l-.6,2.1 H9.7 l-.6,-2.1 a7,7 0 0 1 -1.6,-.9 l-2.1,.7 -2.3,-4 1.5,-1.6 a7,7 0 0 1 0,-1.9 l-1.5,-1.6 2.3,-4 2.1,.7 a7,7 0 0 1 1.6,-.9 Z">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.6" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M12,12.4 m-3.1,0 a3.1,3.1 0 1 0 6.2,0 a3.1,3.1 0 1 0 -6.2,0">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.8" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#a78bfa" Geometry="F1 M12,12.4 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconExport">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M12,3 L12,15 M12,3 L7.5,7.5 M12,3 L16.5,7.5">
            <GeometryDrawing.Pen><Pen Brush="#bdc9da" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5,13 L5,19 C5,20 6,21 7,21 L17,21 C18,21 19,20 19,19 L19,13">
            <GeometryDrawing.Pen><Pen Brush="#49d7e8" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <!-- Dark-stroke variants for PRIMARY (teal) buttons: the light slate strokes of the
         normal icons wash out against the bright teal fill, so these use near-black
         strokes with dark teal/violet accents to match the button's dark label. -->
    <DrawingImage x:Key="IconCompareDark">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M2.5,4 h8 v16 h-8 Z M13.5,4 h8 v16 h-8 Z">
            <GeometryDrawing.Pen><Pen Brush="#0d1a20" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5,8 h3 M5,11 h2 M16,11 h3">
            <GeometryDrawing.Pen><Pen Brush="#0a4f4a" Thickness="1.5" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5,15 h3 M16,15 h3 M16,8 h3">
            <GeometryDrawing.Pen><Pen Brush="#3d2f7a" Thickness="1.5" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M9,11 h6 m-2,-2 2,2 -2,2">
            <GeometryDrawing.Pen><Pen Brush="#0a4f4a" Thickness="1.5" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <!-- White-stroke variants for the HOVER state of primary buttons (Fluent turns the
         label white on pointerover, so the icon matches). -->
    <DrawingImage x:Key="IconCompareWhite">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M2.5,4 h8 v16 h-8 Z M13.5,4 h8 v16 h-8 Z">
            <GeometryDrawing.Pen><Pen Brush="#ffffff" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5,8 h3 M5,11 h2 M16,11 h3">
            <GeometryDrawing.Pen><Pen Brush="#ffffff" Thickness="1.5" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M5,15 h3 M16,15 h3 M16,8 h3">
            <GeometryDrawing.Pen><Pen Brush="#ffffff" Thickness="1.5" LineCap="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M9,11 h6 m-2,-2 2,2 -2,2">
            <GeometryDrawing.Pen><Pen Brush="#ffffff" Thickness="1.5" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconWatchAddWhite">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="F1 M2.8,12 s3.2,-5.5 8.2,-5.5 8.2,5.5 8.2,5.5 -3.2,5.5 -8.2,5.5 S2.8,12 2.8,12 Z">
            <GeometryDrawing.Pen><Pen Brush="#ffffff" Thickness="1.7" LineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="F1 M11,12 m-2.5,0 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0">
            <GeometryDrawing.Pen><Pen Brush="#ffffff" Thickness="1.7" /></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#ffffff" Geometry="F1 M11,12 m-.8,0 a.8,.8 0 1 0 1.6,0 a.8,.8 0 1 0 -1.6,0" />
          <GeometryDrawing Geometry="F1 M19,18 m-3.8,0 a3.8,3.8 0 1 0 7.6,0 a3.8,3.8 0 1 0 -7.6,0">
