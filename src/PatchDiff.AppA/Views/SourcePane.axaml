<UserControl x:Class="PatchDiff.Views.SourcePane"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0e1219">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#10161f" BorderBrush="#283142" BorderThickness="0,0,0,1" Padding="15,9">
      <StackPanel>
        <TextBlock x:Name="TypeNameText" FontWeight="SemiBold" FontSize="15" Foreground="#e8edf5" />
        <TextBlock x:Name="MetaText" FontSize="12" Foreground="#8d99ac" Margin="0,2,0,0" />
      </StackPanel>
    </Border>
    <TextBox x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="13" Foreground="#cdd3de"
             Background="#0f141d" BorderThickness="0" Padding="12,9" />
  </DockPanel>
</UserControl>
