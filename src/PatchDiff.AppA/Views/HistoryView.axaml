<UserControl x:Class="PatchDiff.Views.HistoryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0e1219">
  <UserControl.Resources>
    <!-- RevRow → compact toolbar buttons -->
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#10161f" BorderBrush="#283142" BorderThickness="0,0,0,1" Padding="15,9">
      <StackPanel Spacing="2">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" Foreground="#e8edf5" />
        <TextBlock x:Name="MetaText" FontSize="11.5" Foreground="#8d99ac" />
      </StackPanel>
    </Border>

    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
      <TextBlock Text="No revisions yet" FontSize="17" FontWeight="SemiBold" Foreground="#d5dce7" HorizontalAlignment="Center" />
      <TextBlock Text="A baseline was captured on the first check — every analyzed version of this assembly is archived here."
                 FontSize="12" Foreground="#8d99ac" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
    </StackPanel>

    <ListBox x:Name="RevisionList" Margin="10" Background="#0f141d" BorderBrush="#283142" BorderThickness="1"
             CornerRadius="8" Padding="4"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Classes="watch-row" CornerRadius="6" Padding="12,8" Margin="2,1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
              <StackPanel Grid.RowSpan="2" Spacing="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#e8edf5" />
                  <Border CornerRadius="8" Padding="7,2" Background="#222c39" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShaShort}" FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="10" Foreground="#49d7e8" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="#8d99ac" />
              </StackPanel>
              <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button Classes="toolbar" Content="Diff vs previous" Click="OnDiffPrev" />
                <Button Classes="toolbar" Content="Diff vs current" Click="OnDiffCurrent" />
                <Button Classes="toolbar" Content="Restore…" Click="OnRestore" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
