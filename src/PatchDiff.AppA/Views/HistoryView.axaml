<UserControl x:Class="PatchDiff.Views.HistoryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e22">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#26262b" BorderBrush="#33333a" BorderThickness="0,0,0,1" Padding="12,8">
      <StackPanel>
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13" />
        <TextBlock x:Name="MetaText" FontSize="10.5" Foreground="#9a9aa4" Margin="0,2,0,0" />
      </StackPanel>
    </Border>
    <ListBox x:Name="RevisionList" Margin="8" Background="#1b1b1b" BorderThickness="0"
              />
  </DockPanel>
</UserControl>
