<UserControl x:Class="PatchDiff.Views.BrowseView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PatchDiff.Views"
             Background="#0e1219">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#10161f" BorderBrush="#283142" BorderThickness="0,0,0,1" Padding="15,9">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" Foreground="#e8edf5" />
          <TextBlock x:Name="MetaText" FontSize="12" Foreground="#8d99ac" Margin="0,2,0,0" />
        </StackPanel>
        <Button x:Name="ExportTypeBtn" Classes="secondary" Click="OnExportSingle" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False"
                ToolTip.Tip="Save the selected type's decompiled source as a single .cs file">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Image Source="{StaticResource IconExport}" Width="15" Height="15" />
            <TextBlock Text="Export C# file" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Grid ColumnDefinitions="320,4,*">
      <Grid RowDefinitions="*,Auto">
        <TextBox x:Name="TreeFilter" Watermark="Filter types…" Grid.Row="0" Margin="10,10,10,0"
                 TextChanged="OnFilter" Background="#0f141d" BorderBrush="#30394a" BorderThickness="1" Padding="10,6" FontSize="12" />
        <TreeView x:Name="TypeTree" Grid.Row="0" Margin="10,10,10,10" Background="#0f141d" BorderThickness="0"
                  FontSize="12" SelectionChanged="OnTreeSelection">
          <TreeView.DataTemplates>
            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="views:ExplorerNode">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="{Binding Glyph}" FontFamily="Consolas, DejaVu Sans Mono, monospace" Foreground="#7fb2e8" />
                <TextBlock Text="{Binding Header}" Foreground="#dce4ef" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
      </Grid>
      <GridSplitter Grid.Column="1" Width="4" Background="#283142" ResizeBehavior="CurrentAndNext" />
      <TextBox x:Name="SourceText" Grid.Column="2" Margin="0,10,10,10" IsReadOnly="True" AcceptsReturn="True"
               TextWrapping="NoWrap" FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="13" Background="#0f141d"
               BorderThickness="0" Padding="12,9" CaretBrush="#4cc2ff" Foreground="#cdd3de" />
    </Grid>
  </DockPanel>
</UserControl>
